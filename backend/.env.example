# ============================================================
# Backend Environment Variables Template
# ============================================================
# Copy this file to .env or set these as system environment variables.
# NEVER commit actual secrets to version control.
# ============================================================

# MySQL Database
DB_URL=jdbc:mysql://localhost:3306/smart_complaint_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Secret (use a long, random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_2024
JWT_EXPIRATION_MS=86400000

# AI Provider Configuration
# Options: openai, gemini, fallback
AI_PROVIDER=fallback
AI_API_KEY=your_ai_api_key_here
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-3.5-turbo
AI_TIMEOUT=10

# For Gemini, use:
# AI_PROVIDER=gemini
# AI_API_KEY=your_gemini_api_key_here
# AI_MODEL=gemini-pro

# CORS
CORS_ORIGINS=http://localhost:5173
